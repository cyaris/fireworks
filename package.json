{
  "name": "fireworks",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "linklocal",
    "dev": "vite --host",
    "dev:open": "vite --host --open",
    "build": "svelte-kit sync && svelte-package",
    "build:watch": "svelte-kit sync && svelte-package -w",
    "package": "vite package",
    "preview": "vite preview",
    "preview:open": "vite preview --open",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write '**/*.{css,cjs,html,js,json,svelte,svg}'",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check '**/*.{css,cjs,html,js,json,svelte,svg}'",
    "lint": "eslint '**/*.{cjs,html,js,svelte}'",
    "lint:fix": "eslint --fix '**/*.{cjs,html,js,svelte}'",
    "rollup": "rollup -c rollup.config.js",
    "rollup:watch": "rollup -c rollup.config.js -w",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "svelte": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./functions": {
      "import": "./dist/functions/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "overrides": {
    "cookie": "^0.7.2",
    "esbuild": "^0.25.2"
  },
  "dependencies": {
    "d3-ease": "3",
    "d3-random": "3",
    "linklocal": "^2.8.2",
    "svelte": "4.2.20",
    "svelte-lib": "file:../svelte-lib",
    "vite": "^5.4.21"
  }
}
